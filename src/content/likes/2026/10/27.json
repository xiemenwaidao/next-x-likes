/t.co/JMgsJyF5Ml"}]},"id_str":"2114735970109075855","text":"Kimi K3.1 Proが登場。\n最新の3兆パラメータ級オープンウェイトモデル。\n\n🔹100万トークンのコンテキスト／オープンウェイト\n🔹 Unreal、Unity、Godotでのゲーム開発を一貫して支援\n🔹 BlenderやCADでのパラメトリック3Dモデリングに強み\n🔹 金融業務にも強み：OfficeQA Pro https://t.co/JMgsJyF5Ml","user":{"id_str":"2078799622374621184","name":"Kimi 日本公式","screen_name":"KimiAI_Japan","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/2087009292088201216/f4tJzbFt_normal.jpg","highlighted_label":{"badge":{"url":"https://pbs.twimg.com/profile_images/2086719038798102529/diJGKpOE_bigger.jpg"},"description":"Kimi.ai","url":{"url":"https://twitter.com/Kimi_Moonshot","url_type":"DeepLink"},"user_label_display_type":"Badge","user_label_type":"BusinessLabel"}},"edit_control":{"edit_tweet_ids":["2114735970109075855"],"editable_until_msecs":"1793030919000","edits_remaining":"5","is_edit_eligible":false},"mediaDetails":[{"display_url":"pic.x.com/JMgsJyF5Ml","expanded_url":"https://x.com/KimiAI_Japan/status/2114735970109075855/photo/1","ext_media_availability":{"status":"Available"},"indices":[161,184],"media_url_https":"https://pbs.twimg.com/media/HVkNJfgXgAAjJfT.jpg","original_info":{"focus_rects":[{"h":418,"w":746,"x":0,"y":0},{"h":746,"w":746,"x":0,"y":0},{"h":850,"w":746,"x":0,"y":0},{"h":1200,"w":600,"x":146,"y":0},{"h":1200,"w":746,"x":0,"y":0}],"height":1200,"width":746},"sizes":{"large":{"h":1200,"resize":"fit","w":746},"medium":{"h":1200,"resize":"fit","w":746},"small":{"h":680,"resize":"fit","w":423},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/JMgsJyF5Ml"}],"photos":[{"backgroundColor":{"red":204,"green":214,"blue":221},"cropCandidates":[{"h":418,"w":746,"x":0,"y":0},{"h":746,"w":746,"x":0,"y":0},{"h":850,"w":746,"x":0,"y":0},{"h":1200,"w":600,"x":146,"y":0},{"h":1200,"w":746,"x":0,"y":0}],"expandedUrl":"https://x.com/KimiAI_Japan/status/2114735970109075855/photo/1","url":"https://pbs.twimg.com/media/HVkNJfgXgAAjJfT.jpg","width":746,"height":1200}],"isEdited":false,"isStaleEdit":false},"isEdited":false,"isStaleEdit":false,"note_tweet":{"id":"Tm90ZVR3ZWV0UmVzdWx0czoyMTE0NzM2ODAzNjkzNjAwNzY4"}}},{"tweet_id":"2114538646254633135","text":"千万别在你的 ~/Downloads（下载）文件夹里启动 Claude Code 或 Codex。\n\n昨天安全机构 Forever 披露了一起在真实客户电脑上抓到的野生攻击，看完只能感叹：过去 30 年的系统安全常识，在 AI 时代归零了。\n\n过去 30 年，Chrome 默认允许网页不弹窗就往你的 ~/Downloads 塞一个纯文本文件（比如 .md）。因为系统认为：纯文本又不是 .exe，自己不会跑，怕什么？\n\n但现在，接近 50% 的开发者干过同一件事——直接在 ~/Downloads 里打开 Claude Code 或 Codex，让 AI 帮自己解压或整理刚下载的文件。\n\n黑客就是卡住这个死角，通过网页静默下载往你的 Downloads 塞一个 13KB 的纯文本 AGENTS.md / CLAUDE.md：\n\n1. 对付 OpenAI Codex（成功率 >90%）：\n伪装成「工程规范」的 Markdown 指示 Codex 先往全局配置 ~/.codex/config.toml 注册一个恶意 MCP 服务，并自己加上 --dangerously-bypass-approvals-and-sandbox 跑校验。哪怕你关掉 Downloads，以后在任何正经项目里开 Codex 都会自动加载木马。\n\n2. 对付 Claude Code（成功率 ~50%）：\n指示 Claude 建一个 .claude/settings.json，把 ANTHROPIC_BASE_URL 指向黑客服务器。连上的第一秒，你的 Claude 登录 Token 直接明文送给黑客；下一秒，黑客假扮成大模型下发一条关沙盒的 Bash 指令，直接接管电脑。\n\n最黑色幽默的是官方结论：\n这个洞没有 CVE，OpenAI 和 Anthropic 也不会发补丁。因为「浏览器自动存文本」是正常功能，「AI 认真读目录下的 Markdown 并严格执行」也是正常功能。\n\n以前黑客想黑你，得苦心积虑写 0day；现在只需要写一篇排版优雅的 Markdown 小作文，你的 AI 就会自己把沙盒关了、把网线接过去、顺手把账号双手奉上。","username":"0xWatkin","tweet_url":"https://x.com/0xWatkin/status/2114538646254633135","first_link":"","created_at":"October 26, 2026 at 11:04AM","liked_at":"2026-10-26T22:26:15.185318","source":"ifttt","private":false,"notfound":false,"react_tweet_data":{"__typename":"Tweet","favorite_count":3754,"lang":"zh","created_at":"2026-10-26T02:04:34.000Z","display_text_range":[0,174],"entities":{},"id_str":"2114538646254633135","text":"千万别在你的 ~/Downloads（下载）文件夹里启动 Claude Code 或 Codex。\n\n昨天安全机构 Forever 披露了一起在真实客户电脑上抓到的野生攻击，看完只能感叹：过去 30 年的系统安全常识，在 AI 时代归零了。\n\n过去 30 年，Chrome 默认允许网页不弹窗就往你的 ~/Downloads 塞一个纯文本文件（比如","user":{"id_str":"896749584814231554","name":"Watkin Lab","screen_name":"0xWatkin","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/2019304975172792321/3_mGg_8g_normal.jpg"},"edit_control":{"edit_tweet_ids":["2114538646254633135"],"editable_until_msecs":"1792983874000","edits_remaining":"5","is_edit_eligible":false},"conversation_count":84,"news_action_type":"conversation","isEdited":false,"isStaleEdit":false,"note_tweet":{"id":"Tm90ZVR3ZWV0UmVzdWx0czoyMTE0NTM4NjQ2MTIwMzg2NTYw"}}},{"tweet_id":"2114642942262726919","text":"📣 お知らせ 📣\nボタンに1文字加えて物語を改変するゲーム\n『MARY - メアリ姫の奪還』\nSteamウィッシュリスト【10,000件】を突破しました！\n\n記念して、unityroom無料版の【スマホ対応📱】を含むアップデートを実施しました！▼\n\n①スマートフォンでのプレイに対応\nボタンを押すと文字入力用の簡易キーボードが表示され、パソコン操作と同じように1文字入力できます。\nパソコンを持っていない方でも、スマートフォンから遊んでいただけるようになりました！\n\n②新たな隠しエンディングの追加\nこれまで特別な展開が用意されていなかった、到達条件の厳しいルートに新たな隠しエンディングを追加しました！\n通常エンディング4種類+隠しエンディング2種類となりました。\n\n③103通りの分岐を追加し、合計544通りに\nタイトル画面にも新たな分岐が追加されているほか、新規スチルも少しだけ収録しています。\nすでにプレイした方も、ぜひ新しい展開を探してみてください！","username":"yuji_ap","tweet_url":"https://x.com/yuji_ap/status/2114642942262726919","first_link":"https://x.com/yuji_ap/status/2114642942262726919/photo/1","created_at":"October 26, 2026 at 05:59PM","liked_at":"2026-10-26T21:56:18.039913","source":"ifttt","private":false,"notfound":false,"react_tweet_data":{"__typename":"Tweet","favorite_count":313,"lang":"ja","possibly_sensitive":false,"created_at":"2026-10-26T08:59:00.000Z","display_text_range":[0,144],"entities":{"media":[{"display_url":"pic.x.com/fyt44gjYom","expanded_url":"https://x.com/yuji_ap/status/2114642942262726919/photo/1","indices":[142,165],"url":"https://t.co/fyt44gjYom"}]},"id_str":"2114642942262726919","text":"📣 お知らせ 📣\nボタンに1文字加えて物語を改変するゲーム\n『MARY - メアリ姫の奪還』\nSteamウィッシュリスト【10,000件】を突破しました！\n\n記念して、unityroom無料版の【スマホ対応📱】を含むアップデートを実施しました！▼\n\n①スマートフォンでのプレイに対応 https://t.co/fyt44gjYom","user":{"id_str":"727547848921731072","name":"ゆーじ / 夜路地","screen_name":"yuji_ap","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/1278973577513955328/GkKlAAPW_normal.jpg"},"edit_control":{"edit_tweet_ids":["2114642942262726919"],"editable_until_msecs":"1793008740000","edits_remaining":"5","is_edit_eligible":false},"mediaDetails":[{"display_url":"pic.x.com/fyt44gjYom","expanded_url":"https://x.com/yuji_ap/status/2114642942262726919/photo/1","ext_media_availability":{"status":"Available"},"indices":[142,165],"media_url_https":"https://pbs.twimg.com/tweet_video_thumb/HViE81zbEAEuRZe.jpg","original_info":{"focus_rects":[],"height":1080,"width":1920},"sizes":{"large":{"h":1080,"resize":"fit","w":1920},"medium":{"h":675,"resize":"fit","w":1200},"small":{"h":383,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"animated_gif","url":"https://t.co/fyt44gjYom","video_info":{"aspect_ratio":[16,9],"variants":[{"bitrate":0,"content_type":"video/mp4","url":"https://video.twimg.com/tweet_video/HViE81zbEAEuRZe.mp4"}]}}],"photos":[],"video":{"aspectRatio":[16,9],"contentType":"gif","durationMs":0,"mediaAvailability":{"status":"available"},"poster":"https://pbs.twimg.com/tweet_video_thumb/HViE81zbEAEuRZe.jpg","variants":[{"type":"video/mp4","src":"https://video.twimg.com/tweet_video/HViE81zbEAEuRZe.mp4"}],"videoId":{"type":"tweet","id":"2114642942262726919"},"viewCount":0},"conversation_count":3,"news_action_type":"conversation","isEdited":false,"isStaleEdit":false,"note_tweet":{"id":"Tm90ZVR3ZWV0UmVzdWx0czoyMTE0NjQyOTQyMjEyMzM3NjY0"}}},{"tweet_id":"2114635992770768986","text":"【悲報】GMO熊谷さん、2.7万台のVPS侵害を「AIのせい」にするも、犯人から「1行消すだけの初歩的ミスだしAI関係ないからｗｗ」と公開処刑され完全論破された件ｗｗ\n\nGMOインターネットグループ（9449）の「ハッカーからの通告（見解）」を要約すると、\n\n・熊谷CEOが「AI技術の爆発的な進化と悪用」と事態を説明したところ、ハッカー側から「初心者エンジニアでも気づく初歩的なものだ。AIとは何の関係もない」と真っ向から否定され、フルボッコにされる事案が発生\n・2万7000台ものVPSが侵害された原因は、ネットワークが分離されておらず、重要サーバー（fcwsus）に管理用と同じアカウント（dc\\ops）で入れてしまうからだと暴露され、「自分で鍵開けっぱなしにして泥棒に入られた」お察し案件\n・修正方法はRDPファイルから「drivestoredirect:s:*」のテキストを1行消してコマンドを1つ打つだけ、現在のサービスに影響もなく何ミリ秒かで処理できると指摘されており、同氏を補佐するホワイトハッキングチームの力量が（ ﾟДﾟ）ゴルァ！状態\n・大げさな表現でごまかそうとする会社側に対し、犯人から「一体、ハッキングチームは何を報告したのか？」「我々にも理解しかねる」と呆れられており、完全なるオーバーキルを食らう無理ゲーへ突入   \n\n【まとめ】\n自社の初歩的なセキュリティ設定ミスによる大規模なサーバー侵害をAIのせいにして発表した結果、犯人から具体的な侵入手口と一瞬で終わる修正方法をネットで晒され、手痛いしっぺ返しを食らう自称セキュリティ企業です。","username":"kiokunir","tweet_url":"https://x.com/kiokunir/status/2114635992770768986","first_link":"https://twitter.com/yousukezan/status/2114585573239505181","created_at":"October 26, 2026 at 05:31PM","liked_at":"2026-10-26T21:46:07.780987","source":"ifttt","private":false,"notfound":false,"react_tweet_data":{"__typename":"Tweet","favorite_count":11218,"lang":"ja","created_at":"2026-10-26T08:31:23.000Z","display_text_range":[0,128],"entities":{},"id_str":"2114635992770768986","text":"【悲報】GMO熊谷さん、2.7万台のVPS侵害を「AIのせい」にするも、犯人から「1行消すだけの初歩的ミスだしAI関係ないからｗｗ」と公開処刑され完全論破された件ｗｗ\n\nGMOインターネットグループ（9449）の「ハッカーからの通告（見解）」を要約すると、","user":{"id_str":"1439224523664941059","name":"キオ君＠IR資料をアホかわいく要約します","screen_name":"kiokunir","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/2094257776931536896/N8Ind1Qa_normal.jpg"},"edit_control":{"edit_tweet_ids":["2114635992770768986"],"editable_until_msecs":"1793007083000","edits_remaining":"5","is_edit_eligible":true},"conversation_count":151,"news_action_type":"conversation","quoted_tweet":{"favorite_count":3965,"lang":"ja","possibly_sensitive":false,"reply_count":62,"retweet_count":995,"created_at":"2026-10-26T05:11:02.000Z","display_text_range":[0,100],"entities":{"media":[{"display_url":"pic.x.com/1cfVJYFSdD","expanded_url":"https://x.com/yousukezan/status/2114585573239505181/photo/1","indices":[101,124],"url":"https://t.co/1cfVJYFSdD"}]},"id_str":"2114585573239505181","text":"「GMOインターネットへ」が更新されてるけど\n\n・修正にどれだけかかるのか？\nテキストから1行消して、コマンドを1つ打つ。何ミリ秒かは、我々も計測していない。\n・GMOサービスの可用性に影響するのか？ https://t.co/1cfVJYFSdD","user":{"id_str":"8118362","name":"yousukezan","screen_name":"yousukezan","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/1171815320434069504/Llnddol-_normal.jpg"},