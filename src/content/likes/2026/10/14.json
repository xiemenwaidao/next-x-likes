0},{"h":1200,"w":1200,"x":0,"y":0}],"height":1200,"width":1200},"sizes":{"large":{"h":1200,"resize":"fit","w":1200},"medium":{"h":1200,"resize":"fit","w":1200},"small":{"h":680,"resize":"fit","w":680},"thumb":{"h":150,"resize":"crop","w":150}},"type":"photo","url":"https://t.co/eqnk9Oso5E"}],"photos":[{"backgroundColor":{"red":204,"green":214,"blue":221},"cropCandidates":[{"h":672,"w":1200,"x":0,"y":528},{"h":1200,"w":1200,"x":0,"y":0},{"h":1200,"w":1053,"x":147,"y":0},{"h":1200,"w":600,"x":390,"y":0},{"h":1200,"w":1200,"x":0,"y":0}],"expandedUrl":"https://x.com/mount_inc/status/2110218234633072885/photo/1","url":"https://pbs.twimg.com/media/HUkAEFWasAAmdg7.jpg","width":1200,"height":1200}],"conversation_count":0,"news_action_type":"conversation","isEdited":false,"isStaleEdit":false}},{"tweet_id":"2110110778997010637","text":"anthropic git'i bırakmış.\n\nçünkü kendi version control sistemini yazmış. adı da scion. sebebi de yazıyı okuyunca anlaşılıyo.\n\nclaude code vb gibi coding agentlar sayesinde artık kod yazmak bottleneck değil, yazılan kodu yönetmek. \n\nanthropic ekibinin git’inde mayıs 2026'da günde 2 bin 500 merge varken eylülde 30 bini geçmiş. 5 ayda neredeyse 12 kat olmuş. \n\nmonorepo'nun sadece main branch geçmişi 100 gb civarı olmuş. sadece ci için günde 25 milyon checkout yapılıyormuş, agent'lar ve developer'lar hariç. \n\ngit'i ayakta tutmak için yüzlerce mirror çalıştırmak zorunda kalmışlar. yamamışlar, bantlamışlar ama yetmemiş.\n\nçünkü git biz insanlar için geliştirildi. git decentralized bi sistem, her client offline çalışabilsin diye tasarlanmış, herkes repo'nun tam kopyasını taşıyor. ama anthropic'te repo'ya bağlananların neredeyse hepsi zaten hep online olan ai agent'lar ve job'lar. o zaman neden herkes koca repo'yu sırtında taşımak zorunda kalsın ki diye düşünmüşler.\n\no yüzden commit, merge, rebase, diff ne varsa server'a taşımışlar. client sadece ihtiyacı olan dosyayı çekiyor.\n\nsonuçta şu olmuş: checkout dakikalardan saniyelere inmiş, altyapının cpu ve memory ihtiyacı eski mirror düzenine göre 200 kat azalmış, ci'da da %25 cpu kazanmışlar.\n\ndaha ilginci, scion'u ve antique dedikleri code review sistemini 7 kişi, 5 ayda yapmış. \n\nnormalde şirketlerin aylarını hatta belki aylarını alacak bi iş bu.\n\nclaude reis önce kod üretimini o kadar hızlandırmış ki altyapı yetmemiş. sonra o altyapının yerine geçecek sistemi yazmayı da hızlandırmış.\n\nekipteki herkes claude'un kod yazmada kendisinden iyi olduğunu kabul ediyormuş. (hiç ego yapmamışlar(!))\n\nreview yaparken satır satır kod okumayı bırakmışlar, \"bu değişiklik ne yapmaya çalışıyor\" ona bakıyorlarmış.\n\nbu arada scion git'in yerine geçecek bi şey değilmiş zaten bunu kendileri de söylüyor. \n\nbence asıl mesele git'in eskimesi değil, \n\nsoftware development lifecycle'ın insan ölçeğinde tasarlanmış olması. binlerce agent aynı anda kod basmaya başlayınca sadece kodu nasıl yazdığımız değil, nasıl sakladığımız, test ettiğimiz ve merge ettiğimiz de değişmek zorunda.","username":"gryhkn","tweet_url":"https://x.com/gryhkn/status/2110110778997010637","first_link":"https://twitter.com/anthropicai/status/2110047081414987957","created_at":"October 14, 2026 at 05:49AM","liked_at":"2026-10-14T09:26:13.521520","source":"ifttt","private":false,"notfound":false,"react_tweet_data":{"__typename":"Tweet","favorite_count":2866,"lang":"tr","created_at":"2026-10-13T20:49:48.000Z","display_text_range":[0,279],"entities":{},"id_str":"2110110778997010637","text":"anthropic git'i bırakmış.\n\nçünkü kendi version control sistemini yazmış. adı da scion. sebebi de yazıyı okuyunca anlaşılıyo.\n\nclaude code vb gibi coding agentlar sayesinde artık kod yazmak bottleneck değil, yazılan kodu yönetmek. \n\nanthropic ekibinin git’inde mayıs 2026'da günde","user":{"id_str":"1876450758","name":"hakan giray","screen_name":"gryhkn","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/1702370466667610112/iLpizi1b_normal.jpg"},"edit_control":{"edit_tweet_ids":["2110110778997010637"],"editable_until_msecs":"1791928188000","edits_remaining":"5","is_edit_eligible":true},"conversation_count":51,"news_action_type":"conversation","quoted_tweet":{"favorite_count":24277,"lang":"en","reply_count":1046,"retweet_count":2454,"created_at":"2026-10-13T16:36:41.000Z","display_text_range":[0,274],"entities":{},"id_str":"2110047081414987957","text":"New on our Engineering blog: Creating in-house source control. \n\nIn May, we merged around 2,500 code changes per day. In September, we merged more than 30,000 per day. As a result, we became bottlenecked by developer infrastructure built for human (rather than agent) scale.","user":{"id_str":"1353836358901501952","name":"Anthropic","screen_name":"AnthropicAI","is_blue_verified":true,"profile_image_shape":"Square","verified":false,"verified_type":"Business","profile_image_url_https":"https://pbs.twimg.com/profile_images/1798110641414443008/XP8gyBaY_normal.jpg"},"edit_control":{"edit_tweet_ids":["2110047081414987957"],"editable_until_msecs":"1791913001000","edits_remaining":"5","is_edit_eligible":true},"isEdited":false,"isStaleEdit":false},"isEdited":false,"isStaleEdit":false,"note_tweet":{"id":"Tm90ZVR3ZWV0UmVzdWx0czoyMTEwMTEwNzc4Nzc0NjY3MjY1"}}},{"tweet_id":"2110047081414987957","text":"New on our Engineering blog: Creating in-house source control. \n\nIn May, we merged around 2,500 code changes per day. In September, we merged more than 30,000 per day. As a result, we became bottlenecked by developer infrastructure built for human (rather than agent) scale.  \n\nHere, we share how we built a new version control system—and fully migrated our monorepo from git—in five months: https://t.co/wzNkwHs7IN","username":"AnthropicAI","tweet_url":"https://x.com/AnthropicAI/status/2110047081414987957","first_link":"","created_at":"October 14, 2026 at 01:36AM","liked_at":"2026-10-14T09:26:12.275869","source":"ifttt","private":false,"notfound":f