:44:57.000Z","display_text_range":[0,37],"entities":{"urls":[{"display_url":"gigazine.net/news/20260927-…","expanded_url":"https://gigazine.net/news/20260927-reverse-engineering-adhd-test/","indices":[14,37],"url":"https://t.co/4iyFfP8M5S"}]},"id_str":"2104417050592682262","text":"苦痛で耐えられなかった。\n\nhttps://t.co/4iyFfP8M5S","user":{"id_str":"1557083989","name":"村本章憲 - Norikazu Muramoto","screen_name":"1amageek","is_blue_verified":true,"profile_image_shape":"Circle","verified":false,"profile_image_url_https":"https://pbs.twimg.com/profile_images/1509733653496037376/bs8XD0fL_normal.jpg"},"edit_control":{"edit_tweet_ids":["2104417050592682262"],"editable_until_msecs":"1790570697000","edits_remaining":"5","is_edit_eligible":true},"conversation_count":0,"news_action_type":"conversation","card":{"card_platform":{"platform":{"audience":{"name":"production"},"device":{"name":"iPhone","version":"13"}}},"name":"summary","url":"https://t.co/4iyFfP8M5S","binding_values":{"thumbnail_image":{"image_value":{"height":144,"url":"https://pbs.twimg.com/card_img/2104043432222068736/P6NkCjfY?format=png&name=144x144_2","width":144},"type":"IMAGE"},"description":{"string_value":"自分が注意欠如多動症(ADHD)なのではないかと考えたveritas氏は受診した精神科医からオンラインのADHD検査を受けるように指示されました。検査で受けた奇妙な体験と技術的探求からveritas氏はADHD検査のウェブアプリをリバースエンジニアリングし、詳細をブログにて公開しました。","type":"STRING"},"domain":{"string_value":"gigazine.net","type":"STRING"},"thumbnail_image_large":{"image_value":{"height":420,"url":"https://pbs.twimg.com/card_img/2104043432222068736/P6NkCjfY?format=png&name=420x420_2","width":420},"type":"IMAGE"},"thumbnail_image_original":{"image_value":{"height":1080,"url":"https://pbs.twimg.com/card_img/2104043432222068736/P6NkCjfY?format=png&name=orig","width":1920},"type":"IMAGE"},"site":{"scribe_key":"publisher_id","type":"USER","user_value":{"id_str":"9334242","path":[]}},"thumbnail_image_small":{"image_value":{"height":100,"url":"https://pbs.twimg.com/card_img/2104043432222068736/P6NkCjfY?format=png&name=100x100_2","width":100},"type":"IMAGE"},"thumbnail_image_x_large":{"image_value":{"height":1080,"url":"https://pbs.twimg.com/card_img/2104043432222068736/P6NkCjfY?format=png&name=2048x2048_2_exp","width":1920},"type":"IMAGE"},"vanity_url":{"scribe_key":"vanity_url","string_value":"gigazine.net","type":"STRING"},"thumbnail_image_color":{"image_color_value":{"palette":[{"percentage":98.48,"rgb":{"blue":228,"green":234,"red":226}},{"percentage":0.37,"rgb":{"blue":220,"green":186,"red":149}},{"percentage":0.33,"rgb":{"blue":73,"green":72,"red":70}},{"percentage":0.29,"rgb":{"blue":3,"green":4,"red":253}},{"percentage":0.17,"rgb":{"blue":102,"green":102,"red":248}}]},"type":"IMAGE_COLOR"},"title":{"string_value":"ADHD検査アプリをリバースエンジニアリングした結果","type":"STRING"},"card_url":{"scribe_key":"card_url","string_value":"https://t.co/4iyFfP8M5S","type":"STRING"}}},"isEdited":false,"isStaleEdit":false}},{"tweet_id":"2104216935839989890","text":"DHHの基調講演にモヤること\n\nDHHは手でコードを書くことから新しい開発手法に移れと言っているのではなく、\n\n「エンジニアからクリエイターになれ」\n\nと言っていると思った（「プログラマー引退してmakerになります」発言）\nその証拠に「次はアーキテクトになろうと思っているならそれもLLMに取られるよ」ともツイートしている\n\nプログラマーとして成功することはある程度の再現性があり、努力をすれば報われる可能性が高かった\n\nでもクリエイターはそうではない\n努力すれば米津玄師や宮崎駿になれるか。その再現性はほとんどないよね、という僕の直感は多くの人が共感してくれるところと思う\n\nでもそれができなければ「クソッタレの負け犬」になりますよと\n実際そのような世界になる可能性はある気がする\n\nLLMは「一発逆転のチャンス」みたいに捉える向きもあるが、実際には後天的な努力で得られる技能を無意味化しつつある\n実際には今まで数多くあった逆転の芽が潰されるケースの方が多いように思う\n先天的なセンスがなければ成功できない時代が良いことなのかわからない\n\n以前、「誰でもアプリを作れる」的な文脈でAnthropicハッカソンがよく引き合いに出されていたが、受賞者のプロフィールを見ると医者や弁護士など、まあ自分からするといわゆる知的上流階級的な人たちだなと思った\n誰でもアプリは作れるけど、成功するアプリを作れる人は一握りである\n\n誰もが自分のプロダクトで一発当てる夢追いクリエイターであることを強いられる時代？\n\nそれはすでに生活の心配をしなくていい大金持ちや、太い実家などのパトロンがある人にはただ楽しい余暇の延長なのかもしれないけど、人類の99%にとってはそうではない","username":"dyoshikawa1993","tweet_url":"https://x.com/dyoshikawa1993/status/2104216935839989890","first_link":"","created_at":"September 27, 2026 at 11:29PM","liked_at":"2026-09-28T06:21:15.511699","source":"ifttt","private":false,"notfound":false,"react_tweet_data":{"__typename":"Tweet","favorite_count":259,"lang":"ja","cr